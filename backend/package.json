{
  "name": "portfolio-backend",
  "version": "1.0.0",
  "description": "Backend API for Naveen Agarwal's Portfolio Website",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:with-seed": "npm run seed-if-empty && node server.js",
    "seed-if-empty": "timeout 30s node scripts/checkAndSeed.js || true",
    "dev": "nodemon --exec ts-node server.ts",
    "dev:js": "nodemon server.js",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "echo \"No tests specified\"",
    "optimize-db": "node scripts/optimizeDatabase.js",
    "seed": "node scripts/seedDatabase.js",
    "healthcheck": "curl -f http://localhost:$PORT/health || exit 1"
  },
  "keywords": [
    "portfolio",
    "express",
    "mongodb",
    "jwt",
    "cloudinary",
    "resend"
  ],
  "author": "Naveen Agarwal",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "cjs": "^0.0.11",
    "cloudinary": "^1.41.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "memory-cache": "^0.2.0",
    "mongoose": "^8.18.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^6.9.8",
    "response-time": "^2.3.4",
    "sib-api-v3-sdk": "^8.5.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.96",
    "@types/node": "^25.0.3",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
