# ============================================================================
build/
dist/
out/
.next/
.nuxt/
.cache/
.vite/
.temp/
.tmp/
frontend/build/
frontend/dist/
backend/build/
backend/dist/

# Vite specific
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

