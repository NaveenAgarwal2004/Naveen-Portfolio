# ============================================================================
# Naveen Portfolio - .gitignore
# Complete ignore rules for Node.js, React, Vite, MongoDB, and deployment
# ============================================================================

# ============================================================================
# Node.js Dependencies & Package Managers
# ============================================================================
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins  
!.yarn/releases
!.yarn/versions
.yarn/install-state.gz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npmrc
.yarnrc

# Package manager lock files (uncomment to ignore)
/package-lock.json
/package.json
yarn.lock
**/yarn.lock
# pnpm-lock.yaml

# ============================================================================
# Environment Variables & Secrets
# ============================================================================
.env
.env.*
.env.local
.env.development
.env.test
.env.production
.env.staging
frontend/.env*
backend/.env*

# Specific sensitive files
secrets.json
config/secrets.js
.secrets
credentials.json

# ============================================================================
